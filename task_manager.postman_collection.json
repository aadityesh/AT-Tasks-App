{
  "info": {
    "name": "Task Manager API",
    "description": "CRUD endpoints for the Task model. Run the requests in order (or use the Collection Runner): Create Task saves its id into {{taskId}}, which later requests reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "taskId", "value": "" },
    { "key": "subtaskId", "value": "" }
  ],
  "item": [
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build task manager\",\n  \"description\": \"Finish the DRF assignment\",\n  \"due_date\": \"2026-12-01\",\n  \"priority\": \"high\"\n}"
        },
        "url": "{{baseUrl}}/tasks/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Defaults applied', () => {",
              "  pm.expect(body.completed).to.eql(false);",
              "  pm.expect(body.parent).to.eql(null);",
              "});",
              "pm.collectionVariables.set('taskId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create subtask",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Write models\",\n  \"description\": \"Task model with all fields\",\n  \"parent\": {{taskId}}\n}"
        },
        "url": "{{baseUrl}}/tasks/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Parent is set', () => pm.expect(body.parent).to.eql(Number(pm.collectionVariables.get('taskId'))));",
              "pm.test('Priority defaults to medium', () => pm.expect(body.priority).to.eql('medium'));",
              "pm.collectionVariables.set('subtaskId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Retrieve task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct task returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('taskId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Build task manager v2\",\n  \"description\": \"PUT replaces the whole task, so send every required field\",\n  \"completed\": false,\n  \"due_date\": \"2026-12-05\",\n  \"priority\": \"medium\"\n}"
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('Build task manager v2'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Partial update task (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Marked completed', () => pm.expect(pm.response.json().completed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task - missing title (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"No title, should fail\"\n}"
        },
        "url": "{{baseUrl}}/tasks/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Error mentions title', () => pm.expect(pm.response.json()).to.have.property('title'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create task - invalid priority (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad priority\",\n  \"description\": \"Priority must be low, medium or high\",\n  \"priority\": \"urgent\"\n}"
        },
        "url": "{{baseUrl}}/tasks/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Error mentions priority', () => pm.expect(pm.response.json()).to.have.property('priority'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Subtask deleted with parent (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{subtaskId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Subtask is gone (CASCADE)', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
